# These are examples only. The application does not load .env automatically.
# Export variables in your shell/service; Docker Compose reads .env substitutions.

# Local application defaults:
HOST=127.0.0.1
PORT=9470
CONSOLE_DATA_DIR=data/live
CONSOLE_DEMO=false

# Set this to the exact browser origin when using an HTTPS reverse proxy.
CONSOLE_PUBLIC_ORIGIN=http://127.0.0.1:9470

# Optional file containing a 12–256 character initial password.
# Used only when initializing a new database. Keep the file private.
# CONSOLE_ADMIN_PASSWORD_FILE=/absolute/private/path/admin-password

# Docker Compose host port; container port remains 9470.
CONSOLE_HTTP_PORT=9470
